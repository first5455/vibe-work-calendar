{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "ignorePatterns": ["node_modules/", "dist/", "build/", "*.config.js", "*.config.ts"],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "warn"
  }
}
