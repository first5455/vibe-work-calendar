{
  "name": "vibe-work-calendar",
  "version": "1.3.9-beta",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --filter api build && bun run --filter web build",
    "build:api": "bun run --filter api build",
    "build:web": "bun run --filter web build",
    "lint": "bun run --filter api lint && bun run --filter web lint",
    "lint:fix": "bun run --filter api lint:fix && bun run --filter web lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "bun run --filter api type-check && bun run --filter web type-check",
    "test": "bun run --filter api test && bun run --filter web test",
    "test:api": "bun run --filter api test",
    "test:web": "bun run --filter web test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "db:generate": "bun run --filter api generate",
    "db:migrate": "bun run --filter api migrate",
    "db:studio": "cd apps/api && bunx drizzle-kit studio",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/web/dist",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "bun-types": "latest",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0"
  }
}
